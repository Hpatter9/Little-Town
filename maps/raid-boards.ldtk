				},
				{
					"__identifier": "about",
					"__type": "String",
					"__value": "A river runs across the field, crossed at a wide ford to the north and a narrow one to the south. The town holds the high bank behind logs; a raider who swims the deep middle comes on slowly.",
					"__tile": null,
					"defUid": 116,
					"realEditorValues": [
						{
							"id": "V_String",
							"params": ["A river runs across the field,crossed at a wide ford to the north and a narrow one to the south. The town holds the high bank behind logs; a raider who swims the deep middle comes on slowly."]
						}
					]
